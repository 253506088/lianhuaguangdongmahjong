@echo off
chcp 65001 >nul
title 莲花广麻停服程序

echo ===================================================
echo             莲花广麻 (广东麻将) 停服程序
echo ===================================================
echo.

set FOUND=0

rem 查找占用 5173 端口的进程并关闭
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :5173 ^| findstr LISTENING') do (
    set FOUND=1
    echo 正在终止端口 5173 对应服务进程 [PID: %%a]...
    taskkill /F /PID %%a >nul 2>&1
)

rem 关闭对应窗口标题的终端窗口
taskkill /FI "WINDOWTITLE eq 莲花广麻前端服务*" /F >nul 2>&1

echo.
if "%FOUND%"=="1" (
    echo ===================================================
    echo [成功] 莲花广麻服务已完全停止。
    echo ===================================================
) else (
    echo ===================================================
    echo [提示] 未检测到运行中的服务（端口 5173 未被占用）。
    echo ===================================================
)

echo.
pause
